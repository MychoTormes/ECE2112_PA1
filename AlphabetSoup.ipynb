   "source": [
    "# Define alphabet soup\n",
    "def alphabet_soup(n):\n",
    "    # sort out the letters aplphabetically\n",
    "    str = sorted(n)\n",
    "    # Join the letters forming into a word\n",
    "    z = ''.join(str)\n",
    "    # Display z\n",
    "    print(z) \n",
    "    return z"
   ]
  },
